[Unit]
Description=Clientside Video Thumbnails worker
Documentation=https://github.com/silversong88/clientside_video_thumbnails
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=vtrelay
Group=vtrelay
ExecStart=/opt/clientside-video-thumbnails/bin/node /opt/clientside-video-thumbnails/index.js --env /etc/clientside-video-thumbnails/worker.env
WorkingDirectory=/var/lib/clientside-video-thumbnails
# Paths set here win over the env file (dotenv never overrides existing variables)
Environment=TEMP_DIR=/var/lib/clientside-video-thumbnails/tmp
Environment=FOLDER_CACHE=/var/lib/clientside-video-thumbnails/folder_cache.csv
Environment=THUMB_CACHE=/var/lib/clientside-video-thumbnails/thumb_cache.csv
Environment=FAIL_CACHE=/var/lib/clientside-video-thumbnails/fail_cache.csv
StateDirectory=clientside-video-thumbnails
StateDirectoryMode=0750
UMask=0027
Nice=10
IOSchedulingClass=idle

# Hardening: the worker only needs the network, ffmpeg and its state directory
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
